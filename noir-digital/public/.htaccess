Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType text/vtt .vtt
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"

  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:avif|css|glb|ico|jpe?g|js|mp3|mp4|png|svg|webm|webp|woff2?)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "^(?:hello|cursor)-[a-f0-9]{12}\.glb$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(?:_next/static|assets/v1)/" immutable_asset
    Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
  </IfModule>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.noir-rollback(?:/|$) - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.php [L]
</IfModule>
