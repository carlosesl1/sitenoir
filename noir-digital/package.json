{
  "name": "noir-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:optimize": "uv run --with pillow==12.3.0 --with \"fonttools[woff]==4.63.0\" python scripts/optimize-assets.py",
    "assets:cases": "node scripts/build-case-assets.mjs",
    "assets:cases:v2": "node scripts/build-case-assets-v2.mjs",
    "assets:work": "node scripts/build-work-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "biome check .",
    "test": "vitest run",
    "test:wordpress": "php tests/wordpress/noir-contact-endpoint.test.php",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/interaction",
    "test:visual": "npm run build && playwright test --config=playwright.visual.config.ts",
    "doctor": "react-doctor ."
  },
  "dependencies": {
    "@iconify-icons/simple-icons": "^1.2.74",
    "@iconify-icons/solar": "^1.2.3",
    "@iconify/react": "^6.0.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.6.1",
    "lenis": "1.3.25",
    "motion": "12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "jsdom": "29.1.1",
    "react-doctor": "0.7.3",
    "react-grab": "0.1.48",
    "react-scan": "0.5.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.16"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
